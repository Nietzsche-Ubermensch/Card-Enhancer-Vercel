# Copy to .env and fill in your real tokens:
#   cp .env.example .env
#
# Get tokens at:
#   HF:        https://huggingface.co/settings/tokens  (free)
#   Replicate: https://replicate.com/account/api-tokens (pay-per-use, ~$0.005/image)

HF_API_TOKEN=
REPLICATE_API_TOKEN=

# "realesrgan" = LaMa + SwinIR + Real-ESRGAN API pipeline
# "opencv"     = local-only OpenCV + Pillow (no tokens needed)
UPSCALE_BACKEND=realesrgan

DEBUG=false
MAX_CONCURRENT_WORKERS=2
DEFAULT_OUTPUT_QUALITY=95
