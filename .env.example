# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real tokens.

# Hugging Face API token (for SwinIR stage)
# Get one at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_token_here

# Replicate API token (for LaMa + Real-ESRGAN stages)
# Get one at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Which backend to use: 'realesrgan' (3-stage API pipeline) or 'opencv' (local CPU only)
UPSCALE_BACKEND=realesrgan
