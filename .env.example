# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real tokens.

# ── Backend selection ─────────────────────────────────────────────────────
# 'opencv'     — local CPU pipeline, no API tokens required
# 'realesrgan' — 3-stage API pipeline (LaMa + SwinIR + Real-ESRGAN)
UPSCALE_BACKEND=opencv

# ── API tokens (required when UPSCALE_BACKEND=realesrgan) ────────────────
# Hugging Face token — SwinIR denoising stage
# https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Replicate token — LaMa inpainting + Real-ESRGAN upscaling stages
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── YOLO detection ────────────────────────────────────────────────────────
# Path to YOLO weights file (relative to project root or absolute)
YOLO_MODEL_PATH=models/card_detector_obb.pt

# Minimum confidence score for a detection to be returned [0.0, 1.0]
YOLO_CONFIDENCE=0.4

# Inference device: 'cpu' or 'cuda' (cuda requires an Nvidia GPU + CUDA toolkit)
YOLO_DEVICE=cpu

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Worker pool ───────────────────────────────────────────────────────────
MAX_CONCURRENT_WORKERS=2
WORKER_POLL_INTERVAL=1.0

# ── Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
OUTPUT_DIR=./outputs
MAX_ZIP_SIZE=2147483648
MAX_BATCH_SIZE=3000
MAX_FILE_SIZE=104857600
CLEANUP_AFTER_HOURS=48

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./jobs.db

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
# CORS_ORIGINS=["https://yourfrontend.com"]
