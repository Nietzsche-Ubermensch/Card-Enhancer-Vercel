# Copy names into the Node host / grok mcp --env. Never VITE_*. Never commit values.
GROK_BUILD_DEFAULT_MODEL=grok-4.6
GROK_BUILD_PLUGIN_DATA=
GROK_BUILD_API_FALLBACK=false
GROK_BUILD_ALLOW_WRITE=false
GROK_BUILD_ALLOW_ALWAYS_APPROVE=false
GROK_BUILD_XAI_BASE_URL=https://api.x.ai/v1
GROK_BUILD_XAI_TIMEOUT_MS=120000
GROK_BUILD_TOOL_TIMEOUT_MS=180000
GROK_BUILD_HANDSHAKE_TIMEOUT_MS=15000
GROK_BUILD_GROK_AUTH_PATH=
GROK_BUILD_TTS_BASE_URL=https://api.x.ai/v1/tts
GROK_BUILD_NODE=
GROK_BUILD_CWD=
# XAI_API_KEY is inherited from the process environment — do not paste it here.
